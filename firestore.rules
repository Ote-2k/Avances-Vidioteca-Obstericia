rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // El rol vive en un perfil que solo puede leer su dueño; los clientes no pueden modificarlo.
    function signedIn() {
      return request.auth != null;
    }

    function roleIs(role) {
      return signedIn()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == role;
    }

    function isTeacherUser(userId) {
      return get(/databases/$(database)/documents/usuarios/$(userId)).data.role == 'profesor';
    }

    function teacherOwns(assignmentId) {
      return roleIs('profesor')
        && get(/databases/$(database)/documents/asignaturas/$(assignmentId)).data.ownerUid == request.auth.uid;
    }

    function onlyAppendedCourseComment() {
      let oldComments = resource.data.get('comments', {});
      let newComments = request.resource.data.get('comments', {});
      let oldThread = oldComments.get('course', []);
      let newThread = newComments.get('course', []);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'updatedAt'])
        && newComments.diff(oldComments).affectedKeys().hasOnly(['course'])
        && newComments.diff(oldComments).affectedKeys().size() == 1
        && oldThread is list
        && newThread is list
        && newThread.size() == oldThread.size() + 1
        && newThread[newThread.size() - 1].authorUid == request.auth.uid;
    }

    function onlyUpdatedCourseUnits() {
      let oldCourse = resource.data.get('course', {});
      let newCourse = request.resource.data.get('course', {});
      let changedCourseFields = newCourse.diff(oldCourse).affectedKeys();
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['course', 'updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['course'])
        && changedCourseFields.hasOnly(['units'])
        && changedCourseFields.hasAny(['units'])
        && newCourse.get('units', []) is list;
    }

    function onlyAdminUpdatedCourseDetails() {
      let oldCourse = resource.data.get('course', {});
      let newCourse = request.resource.data.get('course', {});
      let changedCourseFields = newCourse.diff(oldCourse).affectedKeys();
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['course', 'updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['course'])
        && changedCourseFields.hasOnly(['title', 'coverLocalKey', 'coverUrl'])
        && changedCourseFields.hasAny(['title', 'coverLocalKey', 'coverUrl'])
        && newCourse.get('title', '') is string
        && newCourse.get('title', '').size() > 0
        && newCourse.get('title', '').size() <= 80
        && (newCourse.get('coverLocalKey', null) == null || newCourse.get('coverLocalKey', null) is string)
        && (newCourse.get('coverUrl', null) == null || newCourse.get('coverUrl', null) is string);
    }

    function onlyAppendedResourceComment() {
      let oldThread = resource.data.get('comments', []);
      let newThread = request.resource.data.get('comments', []);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'updatedAt'])
        && oldThread is list
        && newThread is list
        && newThread.size() == oldThread.size() + 1
        && newThread[newThread.size() - 1].authorUid == request.auth.uid;
    }

    function resourceHasVideoAndThumbnail() {
      let videoLocalKey = request.resource.data.get('videoLocalKey', null);
      let videoUrl = request.resource.data.get('videoUrl', null);
      let thumbnailUrl = request.resource.data.get('thumbnailUrl', null);
      return thumbnailUrl is string
        && thumbnailUrl.size() > 0
        && ((videoLocalKey is string && videoLocalKey.size() > 0)
          || (videoUrl is string && videoUrl.size() > 0));
    }

    function isNewResourceDraft() {
      return request.resource.data.get('isDraft', false) == true
        && request.resource.data.get('isHidden', false) == true
        && request.resource.data.get('title', '') is string
        && request.resource.data.get('description', '') is string;
    }

    function onlyResourceAttachmentsChanged() {
      let changedFields = request.resource.data.diff(resource.data).affectedKeys();
      return changedFields.size() > 0
        && changedFields.hasOnly(['materials', 'popups', 'comments', 'updatedAt']);
    }

    match /usuarios/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || roleIs('admin'));
      allow list: if roleIs('admin');
      allow create: if roleIs('admin')
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['nombre', 'displayName', 'email', 'role', 'createdAt'])
          && request.resource.data.role == 'alumno'
          && request.resource.data.email == request.auth.token.email);
      allow update, delete: if roleIs('admin');
    }

    match /asignaturas/{assignmentId} {
      // Todos los alumnos pueden consultar las asignaturas creadas.
      allow get: if roleIs('admin')
        || (resource == null && roleIs('profesor'))
        || (roleIs('profesor') && resource.data.ownerUid == request.auth.uid)
        || roleIs('alumno');
      allow list: if roleIs('admin')
        || (roleIs('profesor') && resource.data.ownerUid == request.auth.uid)
        || roleIs('alumno');
      allow create: if roleIs('admin')
          && request.resource.data.ownerUid is string
          && isTeacherUser(request.resource.data.ownerUid)
          && (request.resource.data.course.get('coverLocalKey', null) is string
            || request.resource.data.course.get('coverUrl', null) is string)
          && request.resource.data.published is bool;
      allow update: if (roleIs('profesor')
          && resource.data.ownerUid == request.auth.uid
          && (onlyUpdatedCourseUnits() || onlyAppendedCourseComment()))
        || (roleIs('admin') && onlyAdminUpdatedCourseDetails())
        || (roleIs('alumno') && onlyAppendedCourseComment());
      allow delete: if roleIs('admin');

      match /recursos/{resourceId} {
        // El alumno lee recursos visibles; solo el profesor propietario puede editarlos.
        allow read: if roleIs('admin')
          || teacherOwns(assignmentId)
          || (roleIs('alumno')
            && resource.data.get('isHidden', false) == false
            && resource.data.get('isDraft', false) == false);
        allow create: if teacherOwns(assignmentId) && (resourceHasVideoAndThumbnail() || isNewResourceDraft());
        allow delete: if teacherOwns(assignmentId) || roleIs('admin');
        allow update: if (teacherOwns(assignmentId)
            && (resourceHasVideoAndThumbnail() || onlyResourceAttachmentsChanged()))
          || (roleIs('alumno')
            && resource.data.get('isHidden', false) == false
            && resource.data.get('isDraft', false) == false
            && onlyAppendedResourceComment());
      }
    }

    match /notificaciones/{notificationId} {
      allow get, list: if roleIs('alumno') && resource.data.usuarioUid == request.auth.uid;
      allow update: if roleIs('alumno')
        && resource.data.usuarioUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leido'])
        && request.resource.data.leido == true;
      allow create, delete: if false;
    }
  }
}
