rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // El rol vive en un perfil que solo puede leer su dueño; los clientes no pueden modificarlo.
    function signedIn() {
      return request.auth != null;
    }

    function roleIs(role) {
      return signedIn()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == role;
    }

    function teacherOwns(assignmentId) {
      return roleIs('profesor')
        && get(/databases/$(database)/documents/asignaturas/$(assignmentId)).data.ownerUid == request.auth.uid;
    }

    function studentCanRead(assignmentId) {
      let assignment = get(/databases/$(database)/documents/asignaturas/$(assignmentId)).data;
      return roleIs('alumno')
        && request.auth.token.email is string
        && assignment.published == true
        && assignment.get('estudiantesInscritos', []).hasAny([request.auth.token.email.lower()]);
    }

    function onlyAppendedCourseComment() {
      let oldComments = resource.data.get('comments', {});
      let newComments = request.resource.data.get('comments', {});
      let oldThread = oldComments.get('course', []);
      let newThread = newComments.get('course', []);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'updatedAt'])
        && newComments.diff(oldComments).affectedKeys().hasOnly(['course'])
        && newComments.diff(oldComments).affectedKeys().size() == 1
        && oldThread is list
        && newThread is list
        && newThread.size() == oldThread.size() + 1
        && newThread[newThread.size() - 1].authorUid == request.auth.uid;
    }

    function onlyAppendedResourceComment() {
      let oldThread = resource.data.get('comments', []);
      let newThread = request.resource.data.get('comments', []);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'updatedAt'])
        && oldThread is list
        && newThread is list
        && newThread.size() == oldThread.size() + 1
        && newThread[newThread.size() - 1].authorUid == request.auth.uid;
    }

    match /usuarios/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || roleIs('admin'));
      allow list: if roleIs('admin');
      allow create: if roleIs('admin')
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['nombre', 'displayName', 'email', 'role', 'createdAt'])
          && request.resource.data.role == 'alumno'
          && request.resource.data.email == request.auth.token.email);
      allow update, delete: if roleIs('admin');
    }

    match /asignaturas/{assignmentId} {
      // Los alumnos solo consultan asignaturas publicadas en las que están inscritos.
      allow get: if (resource == null && roleIs('profesor'))
        || (roleIs('profesor') && resource.data.ownerUid == request.auth.uid)
        || studentCanRead(assignmentId);
      allow list: if (roleIs('profesor') && resource.data.ownerUid == request.auth.uid)
        || (roleIs('alumno')
          && request.auth.token.email is string
          && resource.data.published == true
          && resource.data.get('estudiantesInscritos', []).hasAny([request.auth.token.email.lower()]));
      allow create: if roleIs('profesor')
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.published is bool;
      allow update: if roleIs('profesor')
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
        || (roleIs('alumno') && resource.data.published == true && onlyAppendedCourseComment());
      allow delete: if roleIs('profesor') && resource.data.ownerUid == request.auth.uid;

      match /recursos/{resourceId} {
        // El alumno lee recursos visibles; solo el profesor propietario puede editarlos.
        allow read: if teacherOwns(assignmentId)
          || (studentCanRead(assignmentId) && resource.data.isHidden == false);
        allow create, delete: if teacherOwns(assignmentId);
        allow update: if teacherOwns(assignmentId)
          || (studentCanRead(assignmentId)
            && resource.data.isHidden == false
            && onlyAppendedResourceComment());
      }
    }

    match /notificaciones/{notificationId} {
      allow get, list: if roleIs('alumno') && resource.data.usuarioUid == request.auth.uid;
      allow update: if roleIs('alumno')
        && resource.data.usuarioUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leido'])
        && request.resource.data.leido == true;
      allow create, delete: if false;
    }
  }
}
